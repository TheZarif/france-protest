# Copy to .env and fill in only what you need. Nothing here is required for
# the default collectors (GDELT, Google News, Bluesky public search, Reddit via
# Arctic Shift, Mastodon, Wikipedia).

# Contact string sent in the User-Agent so API operators can reach us.
TENEBRES_CONTACT=your.email@example.org

# Optional: Hugging Face token if you hit download limits for the NLP models.
HF_TOKEN=
